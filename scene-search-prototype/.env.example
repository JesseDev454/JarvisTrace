# Copy this file to .env and set the password used by your local PostgreSQL DB.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=group8_fyp
DB_USER=fyp_user
DB_PASSWORD=replace-with-your-local-postgres-password

# Optional. Defaults keep uploads, MediaMTX recordings, and evidence in this repo.
JARVISTRACE_STORAGE_ROOT=scene-search-prototype/videos/managed
JARVISTRACE_MEDIAMTX_RECORDINGS_ROOT=mediamtx/recordings
# Set this to a locally generated random secret before starting MediaMTX.
JARVISTRACE_MEDIAMTX_TOKEN=replace-with-a-random-local-token
# Optional if ffprobe is not available on PATH.
# FFPROBE=C:\\tools\\ffmpeg\\bin\\ffprobe.exe
